# ==============================================================================
# SERVER ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ==============================================================================
UPLOADTHING_TOKEN=your_uploadthing_v7_token_here
PORT=3000
NODE_ENV=production

# Firebase Admin Credentials (Optional / Serverless fallback)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_PROJECT_ID=ioniclostandfound
# FIREBASE_CLIENT_EMAIL=your_client_email@ioniclostandfound.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_URL=https://ioniclostandfound-default-rtdb.asia-southeast1.firebasedatabase.app/

# ==============================================================================
# FRONTEND / CLIENT ENVIRONMENT VARIABLES (Vite public variables)
# ==============================================================================
VITE_API_SERVER_URL=https://ioniclostandfound.vercel.app
VITE_DEV_BYPASS_AUTH=false

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=ioniclostandfound.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ioniclostandfound
VITE_FIREBASE_STORAGE_BUCKET=ioniclostandfound.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://ioniclostandfound-default-rtdb.asia-southeast1.firebasedatabase.app/
