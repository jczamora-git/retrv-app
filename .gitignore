# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
.temp/
**/.temp/

*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

.env
.env.*
!.env.example

.idea/
**/.idea/
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
coverage/
dist/
node_modules/
platforms/
server/data/

# Android Keystores & Build Artifacts
*.jks
*.keystore
*.aab
*.apk
*.pepk
retrv-keys/
retrv-keys
